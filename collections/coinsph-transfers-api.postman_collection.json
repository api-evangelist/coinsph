        {
          "id": "bb11db34-2988-4005-be53-0ac1a05f5ed2",
          "name": "Query Transfers (USER_DATA)",
          "request": {
            "name": "Query Transfers (USER_DATA)",
            "description": {
              "content": "If an ID is provided, retrieves an existing transfer record; otherwise, returns a paginated list of transfers.\nSupports querying by ID, client transfer ID, sender/recipient addresses, and pagination parameters.\n\n**Key Notes**\n\n- If both `id` (path) and `client_transfer_id` are passed, `id` takes precedence.\n- `from_address` and `to_address` cannot be used simultaneously.\n- Email addresses must be URL-encoded (e.g., test@gmail.com → test%40gmail.com).\n- Default and maximum `per_page` is 2000.\n\n---\n\n## Additional Info\n\n**Rate Limit** [📖 Learn More](https://api.docs.coins.ph/reference/general#api-limit-introduction)\n\nWeight: 10\n\n**Use Cases** [🧩 SDK](https://api.docs.coins.ph/reference/general#sdk)\n\n- **Single Transfer Lookup** — Use `id` or `client_transfer_id` for precise lookup.\n- **Transfer History** — Use pagination to retrieve transfer history.\n- **Directional Filtering** — Filter by `from_address` or `to_address` to scope results.\n\n**Best Practices**\n\n- Use `client_transfer_id` for quick lookup of specific transfers you initiated.\n- Avoid querying all transfers repeatedly — cache recent results.\n- Use `meta.next_page` to determine if more pages exist.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "openapi",
                "transfer",
                "v3",
                "transfers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_transfer_id",
                  "value": "<string>",
                  "description": "Client Transfer ID for querying a specific transfer. Maximum length 100."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Current page number for pagination. Default: 1."
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "<integer>",
                  "description": "Quantity per page. Default 2000, maximum 2000."
                },
                {
                  "disabled": false,
                  "key": "from_address",
                  "value": "<string>",
                  "description": "The phone number or email for the sender account. Cannot be used with to_address."
                },
                {
                  "disabled": false,
                  "key": "to_address",
                  "value": "<string>",
                  "description": "The phone number or email for the recipient account. Cannot be used with from_address."
                },
                {
                  "disabled": false,
                  "key": "recvWindow",
                  "value": "<long>",
                  "description": "Request validity window in milliseconds. Default: 5000, Maximum: 60000."
                },
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<long>",
                  "description": "(Required) Unix timestamp in milliseconds."
                },
                {
                  "disabled": false,
                  "key": "signature",
                  "value": "<string>",
                  "description": "(Required) HMAC SHA256 signature of the query string [📖 Learn More](https://api.docs.coins.ph/reference/general#signed-endpoint-examples-for-post-openapiv1order)"
                }
              ],
              "variable": []
            },
            "header": [

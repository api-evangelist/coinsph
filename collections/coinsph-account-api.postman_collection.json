t\": \"<string>\",\n    \"cashOutRemaining\": \"<string>\",\n    \"totalWithdrawLimit\": \"<string>\",\n    \"totalWithdrawRemaining\": \"<string>\"\n  },\n  \"updateTime\": \"<long>\"\n}",

                      "mode": "raw",
                      "raw": "{\n  \"rampType\": \"ON_RAMP\",\n  \"orderId\": \"<string>\",\n  \"orderStatus\": \"MANUAL_REVIEW\",\n  \"id\": \"<string>\",\n  \"txId\": \"<string>\",\n  \"errorCode\": \"<string>\",\n  \"errorMessage\": \"<string>\",\n  \"moreInfo\": {\n    \"createdAt\": \"<dateTime>\",\n    \"quoteId\": \"<string>\",\n    \"status\": \"<string>\",\n    \"sourceAmount\": {\n      \"amount\": \"<number>\",\n      \"currency\": \"<string>\",\n      \"zero\": \"<boolean>\",\n      \"positive\": \"<boolean>\"\n    },\n    \"targetAmount\": {\n      \"amount\": \"<number>\",\n      \"currency\": \"<string>\",\n      \"zero\": \"<boolean>\",\n      \"positive\": \"<boolean>\"\n    },\n    \"sourceCurrency\": \"<string>\",\n    \"targetCurrency\": \"<string>\",\n    \"targetWalletAddress\": \"<string>\",\n    \"targetUserId\": \"<string>\",\n    \"targetWalletAddressTag\": \"<string>\",\n    \"errorCode\": \"<string>\",\n    \"errorMessage\": \"<string>\",\n    \"txId\": \"<string>\",\n    \"withdrawId\": \"<string>\",\n    \"orderId\": \"<string>\",\n    \"rampTypeCode\": \"ON_RAMP\"\n  },\n  \"callbackKey\": \"<string,null>\",\n  \"merchantId\": \"<string,null>\",\n  \"timestamp\": \"<long>\"\n}",

                {
                  "name": "Check Server Time",
                  "id": "5ce966f4-a222-432b-b3ce-9079c26b1fc9",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "GET",
                    "header": [

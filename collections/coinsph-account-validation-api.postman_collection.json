          "name": "Query Account Validation Status",
          "request": {
            "name": "Query Account Validation Status",
            "description": {
              "content": "Query the result of an account validation request.\nAt least one of `requestId` or `validationRequestId` must be provided.\n`validationRequestId` takes precedence if both are provided.\n\n**Polling recommendation**: Send the first poll 3 seconds after submission, then use exponential backoff with a max interval of 30 seconds.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "openapi",
                "fiat",
                "v1",
                "account-validation",
                "status-check"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "requestId",
                  "value": "<string>",
                  "description": "Merchant idempotency key (one of requestId or validationRequestId required)"
                },
                {
                  "disabled": false,
                  "key": "validationRequestId",
                  "value": "<string>",
                  "description": "Coins-generated validation request ID. Takes precedence over requestId if both are provided."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Your API key",
                "key": "X-COINS-APIKEY",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) HMAC-SHA256 signature of the query string",
                "key": "signature",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Current Unix timestamp in milliseconds",
                "key": "timestamp",
                "value": "<string>"

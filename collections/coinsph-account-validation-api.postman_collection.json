          "name": "Submit Account Validation Request",
          "request": {
            "name": "Submit Account Validation Request",
            "description": {
              "content": "Create an account validation request. Returns `PENDING` immediately.\nUse the `validationRequestId` from the response to poll the status-check endpoint.\n\n**Idempotency**: Submitting the same `requestId` twice returns the original result without creating a duplicate validation.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "openapi",
                "fiat",
                "v1",
                "account-validation",
                "create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) HMAC-SHA256 signature of the raw JSON request body",
                "key": "signature",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Current Unix timestamp in milliseconds",
                "key": "timestamp",
                "value": "<string>"
              },
              {
                "disabled": false,
                "description": "(Required) Time window in milliseconds for request validity (max 60000)",
                "key": "recvWindow",
                "value": "<integer>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
